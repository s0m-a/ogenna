enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SellingUnit {
  METER
  HALF_METER
  CENTIMETER
  YARD
  PIECE
}

model Product {
  id                  String              @id @default(cuid())
  name                String
  slug                String              @unique
  description         String?
  fabricType          String?
  materialComposition String?
  widthCm             Int?
  weightGsm           Int?
  careInstructions    String?
  status              ProductStatus       @default(DRAFT)
  sellingUnit         SellingUnit         @default(METER)
  minOrderQty         Int                 @default(1)
  qtyIncrement        Int                 @default(1)
  isFeatured          Boolean             @default(false)
  variants            ProductVariant[]
  images              ProductImage[]
  categories          ProductCategory[]
  collections         CollectionProduct[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  archivedAt          DateTime?

  @@index([status])
  @@index([isFeatured])
  // Search indexes (full-text + trigram) are expression indexes Prisma can't
  // describe; they live in the add_product_search migration.
}

model ProductVariant {
  id              String         @id @default(cuid())
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  sku             String?        @unique
  name            String
  attributes      Json           @default("{}")
  priceAmount     Int
  salePriceAmount Int?
  currencyCode    String         @default("NGN")
  isDefault       Boolean        @default(false)
  isActive        Boolean        @default(true)
  inventory       InventoryItem?
  images          ProductImage[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([productId])
  @@index([isActive])
}

model ProductImage {
  id           String          @id @default(cuid())
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  mediaAssetId String?
  mediaAsset   MediaAsset?     @relation(fields: [mediaAssetId], references: [id])
  url          String
  altText      String?
  position     Int             @default(0)
  createdAt    DateTime        @default(now())

  @@index([productId])
  @@index([variantId])
  @@index([mediaAssetId])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([productId, categoryId])
  @@index([categoryId])
}
